# ==========================================
# MENZY SaaS - ENVIRONMENT CONFIGURATION
# ==========================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://menzy.arenova.in
NEXT_PUBLIC_PRODUCT_NAME=Menzy

# Optional SEO & Analytics (Search Console, Bing Webmaster Tools, GA4/GTM)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# Database (Neon Serverless Postgres with Prisma)
# Pooled connection (-pooler) for application query traffic
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct unpooled connection for Prisma CLI migrations and db push
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-key

# Founder Admin Portal Authentication
ADMIN_EMAIL=founder@menzy.app
# Generate a unique PBKDF2 hash; never commit the admin password itself.
ADMIN_PASSWORD_HASH=pbkdf2$210000$replace-with-random-salt$replace-with-derived-hash
# Generate at least 32 random bytes, for example: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Official Google GenAI SDK (Gemini) & Multi-Account Fallback Pool
GEMINI_API_KEY=
# Array of additional Gemini API keys for automatic fallback (JSON array ["k1","k2"] or comma-separated)
GEMINI_API_KEYS=[]
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# OpenAI Fallback (used automatically when all Gemini keys fail or hit quota)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2

# Cloudflare Workers AI (primary food-photo generator when configured)
# Create a token from Workers AI > Use REST API with Account > Workers AI > Read.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_AI_IMAGE_STEPS=8

# Redis (Caching, Atomic Sliding-Window Rate Limiting, BullMQ)
REDIS_URL=redis://localhost:6379

# Object Storage (Cloudflare R2 or Supabase Storage S3)
R2_BUCKET=dishora-assets
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=

# Razorpay Subscriptions (India INR & US USD - plans auto-resolved from code catalog)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Diner AI Rate Limiting (Sliding Window per session & IP)
DINER_RATE_LIMIT_REQUESTS=25
DINER_RATE_LIMIT_WINDOW_SECONDS=300

# Error Tracking
SENTRY_DSN=

# ==========================================
# DISHORA SaaS - ENVIRONMENT CONFIGURATION
# ==========================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=Dishora

# Database (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dishora?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dishora?schema=public"

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-key

# Founder Admin Portal Authentication
ADMIN_EMAIL=founder@dishora.app
ADMIN_PASSWORD_HASH=6c33852deeb473b677760345d4e6d1a601e3b5e47c16641b659c2b9a7b5bb48e # sha256 for 'dishora2026!'
ADMIN_SESSION_SECRET=dishora-production-secret-session-key-minimum-32-chars

# Official Google GenAI SDK (Gemini)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# Redis (Caching, Atomic Sliding-Window Rate Limiting, BullMQ)
REDIS_URL=redis://localhost:6379

# Object Storage (Cloudflare R2 or Supabase Storage)
R2_BUCKET=dishora-assets
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Razorpay Subscriptions (India INR & US USD)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

RAZORPAY_PLAN_IN_STARTER=plan_IN_starter_799
RAZORPAY_PLAN_IN_GROWTH=plan_IN_growth_1499
RAZORPAY_PLAN_IN_PRO=plan_IN_pro_3999

RAZORPAY_PLAN_US_STARTER=plan_US_starter_29
RAZORPAY_PLAN_US_GROWTH=plan_US_growth_59
RAZORPAY_PLAN_US_PRO=plan_US_pro_119

# Diner AI Rate Limiting (Sliding Window per session & IP)
DINER_RATE_LIMIT_REQUESTS=25
DINER_RATE_LIMIT_WINDOW_SECONDS=300

# Error Tracking
SENTRY_DSN=
